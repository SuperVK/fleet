# TEMPLATE ONLY — contains placeholders, no real secret.
#
# The committed secrets.sops.yaml already ships generated values for the
# daemon password and the gate cookie secret — only the Pocket ID OIDC
# client credentials must be filled in:
#
# 1. In the Pocket ID admin UI (sso.victorklomp.nl) register a new OIDC
#    client (confidential):
#      callback URL: https://paseo.victorklomp.nl/oauth2/callback
#      scopes:       openid profile email
# 2. Fill in the generated credentials:
#      SOPS_AGE_KEY_FILE=age.agekey sops edit apps/paseo/secrets.sops.yaml
#      (client-id / client-secret <- Pocket ID)
# 3. Commit and push; Flux rolls the oauth2-proxy Deployment within 10m.
# 4. Open https://paseo.victorklomp.nl -> Pocket ID passkey -> enter the
#    daemon password (read it: sops -d apps/paseo/secrets.sops.yaml).
#
# Rotating the password: edit `password` here, push, then enter the new one
# in the web UI when reconnecting. Rotating `cookie-secret` only drops the
# gate's active sessions (users re-passkey).
apiVersion: v1
kind: Secret
metadata:
  name: paseo
  namespace: paseo
type: Opaque
stringData:
  password: CHANGE_ME_GENERATED
  client-id: CHANGE_ME
  client-secret: CHANGE_ME
  cookie-secret: CHANGE_ME_GENERATED
