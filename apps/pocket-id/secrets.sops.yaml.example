# TEMPLATE ONLY — contains a placeholder, no real secret.
#
# 1. Copy:  cp apps/pocket-id/secrets.sops.yaml.example apps/pocket-id/secrets.sops.yaml
# 2. Replace CHANGE_ME with `openssl rand -base64 32` output.
# 3. Encrypt in place (after .sops.yaml carries your age public key):
#      sops --encrypt --in-place apps/pocket-id/secrets.sops.yaml
# 4. Commit only the encrypted secrets.sops.yaml, never this template filled in.
#
# ENCRYPTION_KEY encrypts Pocket ID's token-signing keys (they are stored
# encrypted in the SQLite DB on the PVC). Losing the key invalidates every
# OIDC client credential — back up this secret and the PVC together.
apiVersion: v1
kind: Secret
metadata:
  name: pocket-id
  namespace: pocket-id
type: Opaque
stringData:
  encryption-key: CHANGE_ME
