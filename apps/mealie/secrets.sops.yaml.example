# TEMPLATE ONLY — contains placeholders, no real secret.
#
# 1. In the Pocket ID admin UI (sso.victorklomp.nl) create a group named
#    `mealie-admins` (OIDC_ADMIN_GROUP in deployment.yaml) and add your user;
#    make sure the user's "Email verified" toggle is on (Mealie requires the
#    email_verified claim).
# 2. Register a confidential OIDC client in Pocket ID:
#      callback URLs: https://recipes.victorklomp.nl/login
#                     https://recipes.victorklomp.nl/login?direct=1
#    scopes: openid profile email
#    and copy the generated Client ID / Client Secret.
# 3. Fill in the committed apps/mealie/secrets.sops.yaml:
#      sops edit apps/mealie/secrets.sops.yaml
# 4. Commit and push; Flux rolls the Deployment with the real credentials.
#
# OIDC_CLIENT_ID / OIDC_CLIENT_SECRET are the confidential-client credentials
# from Pocket ID — rotate them there, then update here.
apiVersion: v1
kind: Secret
metadata:
  name: mealie
  namespace: mealie
type: Opaque
stringData:
  oidc-client-id: CHANGE_ME
  oidc-client-secret: CHANGE_ME
