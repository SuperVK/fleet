# TEMPLATE ONLY — contains placeholders, no real secret.
#
# The committed secrets.sops.yaml already ships generated values for the
# five random secrets (jwt, creds, openid session) — only the Pocket ID OIDC
# client credentials must be filled in:
#
# 1. In the Pocket ID admin UI (sso.victorklomp.nl) register a new OIDC
#    client (confidential):
#      callback URL: https://chat.victorklomp.nl/oauth/openid/callback
#      scopes:       openid profile email
# 2. Fill in the generated credentials:
#      SOPS_AGE_KEY_FILE=age.agekey sops edit apps/librechat/secrets.sops.yaml
#      (oidc-client-id / oidc-client-secret <- Pocket ID)
# 3. Commit and push; Flux rolls the Deployment within 10m.
# 4. Open https://chat.victorklomp.nl -> "Continue with Pocket ID" -> passkey.
#
# If you want admin-managed LLM keys instead of per-user keys pasted in the
# UI, add them here as e.g. `openai-api-key: sk-...` and switch the
# corresponding `value: user_provided` in deployment.yaml to a secretKeyRef.
apiVersion: v1
kind: Secret
metadata:
  name: librechat
  namespace: librechat
type: Opaque
stringData:
  jwt-secret: CHANGE_ME_GENERATED
  jwt-refresh-secret: CHANGE_ME_GENERATED
  creds-key: CHANGE_ME_GENERATED
  creds-iv: CHANGE_ME_GENERATED
  openid-session-secret: CHANGE_ME_GENERATED
  oidc-client-id: CHANGE_ME
  oidc-client-secret: CHANGE_ME
