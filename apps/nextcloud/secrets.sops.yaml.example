# TEMPLATE ONLY — contains placeholders, no real secrets.
#
# 1. Copy:  cp apps/nextcloud/secrets.sops.yaml.example apps/nextcloud/secrets.sops.yaml
# 2. Replace every CHANGE_ME value.
# 3. Encrypt in place (after .sops.yaml carries your age public key):
#      sops --encrypt --in-place apps/nextcloud/secrets.sops.yaml
# 4. Commit only the encrypted secrets.sops.yaml, never this template filled in.
#
# The rclone.conf is used only by the one-shot import Job (OneDrive -> Nextcloud).
# Generate it once on your workstation: rclone config (backend: onedrive), then
# paste the resulting [onedrive] section below.
apiVersion: v1
kind: Secret
metadata:
  name: nextcloud-admin
  namespace: nextcloud
type: Opaque
stringData:
  admin-username: admin
  admin-password: CHANGE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: nextcloud-mariadb
  namespace: nextcloud
type: Opaque
stringData:
  # App-side wiring (externalDatabase.existingSecret in helmrelease.yaml)
  db-username: nextcloud
  mariadb-password: CHANGE_ME
  # Bitnami subchart keys (mariadb.auth.existingSecret)
  mariadb-root-password: CHANGE_ME
  # Required key by the vendored bitnami chart; unused (standalone, no replication).
  mariadb-replication-password: CHANGE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: nextcloud-redis
  namespace: nextcloud
type: Opaque
stringData:
  redis-password: CHANGE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: rclone-config
  namespace: nextcloud
type: Opaque
stringData:
  rclone.conf: |
    [onedrive]
    type = onedrive
    drive_id = CHANGE_ME
    drive_type = personal
    token = CHANGE_ME
