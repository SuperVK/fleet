# TEMPLATE ONLY — contains placeholders, no real secret.
#
# 1. Register an OIDC client in the Pocket ID admin UI (sso.victorklomp.nl),
#      callback URL: https://ha.victorklomp.nl/oauth2/callback
#    and copy the generated Client ID / Client Secret.
# 2. The committed apps/home-assistant/secrets.sops.yaml already carries a
#    generated cookie-secret; fill in the two placeholders:
#      sops edit apps/home-assistant/secrets.sops.yaml
#    (client-id / client-secret come from Pocket ID; leave cookie-secret as is)
# 3. Commit and push; Flux reconciles within 10m and oauth2-proxy rolls with
#    the real credentials.
#
# COOKIE_SECRET (AES key for oauth2-proxy's session cookies) was generated
# once with `openssl rand -base64 32`; rotating it only logs everyone out of
# the SSO gate. CLIENT_ID / CLIENT_SECRET are the confidential-client
# credentials from Pocket ID — rotate them there, then update here.
apiVersion: v1
kind: Secret
metadata:
  name: oauth2-proxy
  namespace: home-assistant
type: Opaque
stringData:
  client-id: CHANGE_ME
  client-secret: CHANGE_ME
  cookie-secret: CHANGE_ME
